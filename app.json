{
  "expo": {
    "name": "ScorePlay",
    "slug": "ScorePlay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/logo-black.png",
        "resizeMode": "contain",
        "backgroundColor": "#111111"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "splash": {
        "image": "./assets/logo-black.png",
        "resizeMode": "contain",
        "backgroundColor": "#111111"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "splash": {
        "image": "./assets/logo-black.png",
        "resizeMode": "contain",
        "backgroundColor": "#111111"
      }
    }
  }
}